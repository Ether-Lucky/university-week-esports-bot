# ─────────────────────────────────────────────────────────────
# University Week E-Sports Bot — environment configuration
# Copy to `.env` and fill in real values. NEVER put real secrets in THIS file
# (.env.example is committed). Real secrets live only in `.env` (gitignored).
# ─────────────────────────────────────────────────────────────

# Discord
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=000000000000000000                 # right-click your server -> Copy Server ID (Developer Mode on)
OWNER_DISCORD_ID=000000000000000000         # optional break-glass only; normal setup uses the E-Sports Head role

# Supabase Postgres (project ref: <your-ref>, region <your-region>)
# For a single persistent bot, use the SESSION-mode pooler (port 5432).
# Get host/region from: Supabase -> Project Settings -> Database -> Connection string -> "Connection pooling".
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Migrations use the sync psycopg driver against the same session pooler.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<ref>:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Verification (OQ-2: external verification bot assigns a "verified" role; we map it to Audience)
VERIFIED_SOURCE_ROLE_ID=000000000000000000

# Behavior
UPLOAD_MAX_MB=8
RECRUIT_TIMEOUT_MINUTES=120
LOG_LEVEL=INFO

# NOTE: if a real password contains special characters, URL-encode them
# (e.g. @ -> %40, # -> %23).
